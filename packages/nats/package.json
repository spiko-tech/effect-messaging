{
  "name": "@effect-messaging/nats",
  "version": "1.0.0-beta.0",
  "description": "An NATS toolkit for Effect",
  "keywords": [
    "typescript",
    "nats"
  ],
  "homepage": "https://github.com/spiko-tech/effect-messaging",
  "bugs": {
    "url": "https://github.com/spiko-tech/effect-messaging/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spiko-tech/effect-messaging.git",
    "directory": "packages/nats"
  },
  "license": "MIT",
  "sideEffects": [],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "codegen": "node ../../scripts/codegen.mjs . 'src/**/index.ts'",
    "build": "tsc -b tsconfig.json tsconfig.release.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "test": "vitest",
    "coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@effect-messaging/core": "workspace:^",
    "@effect/vitest": "4.0.2",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "effect": "4.0.2"
  },
  "peerDependencies": {
    "@effect-messaging/core": "workspace:^",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/nats-core": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "effect": "^4.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "tags": [
    "typescript",
    "nats"
  ]
}
