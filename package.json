{
  "name": "effect-messaging",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "description": "",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel run codegen",
    "build": "tsc -b tsconfig.build.json && pnpm --recursive --parallel run build",
    "circular": "madge --extensions ts --circular --no-color --no-spinner packages/*/src",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "check": "tsc -b tsconfig.json",
    "check-packages": "node scripts/check-packages.mjs",
    "check:watch": "tsc -b tsconfig.json -w",
    "check-recursive": "pnpm --recursive exec tsc -b tsconfig.json",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "docgen": "pnpm --recursive exec docgen && node scripts/docs.mjs",
    "test-types": "tstyche --target '>=5.9'",
    "changeset-version": "changeset version",
    "changeset-publish": "pnpm check && pnpm test-types && pnpm lint && pnpm build && pnpm check-packages && pnpm test && changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-export-namespace-from": "^7.25.9",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@effect/build-utils": "^0.8.9",
    "@effect/docgen": "^0.5.2",
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "dprint": "^0.56.1",
    "effect": "4.0.0-rc.112",
    "glob": "^13.0.6",
    "madge": "^8.0.0",
    "oxlint": "^1.80.0",
    "tstyche": "^7.2.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
